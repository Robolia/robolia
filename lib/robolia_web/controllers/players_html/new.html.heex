<section class="py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <%!-- <%= render RoboliaWeb.AccountView, "_sidebar.html", conn: @conn %> --%>

      <div class="flex-1">
        <h3 class="text-2xl font-bold mb-4">Create a new bot for which game?</h3>

        <hr class="my-6 border-gray-200" />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <%= for game <- @games do %>
            <div class="bg-white rounded-lg shadow p-6">
              <div class="flex items-center space-x-4">
                <div class="flex-shrink-0">
                  <img src={game.image_url} class="w-16 h-16 object-cover" />
                </div>

                <div class="flex-1 min-w-0">
                  <p class="text-lg font-semibold text-gray-900 truncate">
                    <%= game.name %>
                  </p>
                  <p class="text-sm text-gray-500">
                    Active bots: <%= @games_count[game.slug] || 0 %>
                  </p>
                </div>
              </div>
              
              <div class="mt-4">
                <.link
                    href={~p"/account/players/new/#{game.slug}"},
                    class="w-full inline-flex justify-center items-center px-4 py-2 border border-indigo-600 text-sm font-medium rounded-md text-indigo-600 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                >
                Choose
                </.link>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
