<div class="bg-white rounded-lg shadow p-6">
  <div class="flex items-center space-x-4">
    <div class="flex-shrink-0">
      <img src={@repository.image_url} class="w-16 h-16 object-cover" />
    </div>

    <div class="flex-1 min-w-0">
      <p class="text-lg font-semibold text-gray-900 truncate">
        <%= @repository.language |> String.capitalize %>
      </p>
      <p class="text-sm text-gray-500">
        Active bots: <%= @languages_count[@repository.language] || 0 %>
      </p>
    </div>
  </div>

  <div class="mt-4">
    <.link
      href={@repository.repository_url}
      target="_blank"
      class="w-full inline-flex justify-center items-center px-4 py-2 border border-indigo-600 text-sm font-medium rounded-md text-indigo-600 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
    >
      Choose
    </.link>
  </div>
</div>
