<div class="w-full">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center space-x-4">
      <div class="flex-shrink-0">
        <img src={@player.game.image_url} class="w-16 h-16 object-cover" />
      </div>

      <div class="flex-1 min-w-0">
        <p class="text-lg font-semibold text-gray-900 truncate">
          <%= @player.game.name %>
        </p>
        <ul class="flex flex-wrap gap-4 text-sm text-gray-500">
          <li>#<%= @player |> current_rank_position %> (<%= @player |> fetch_rating %>)</li>
          <li><%= @player.language |> format_player_language %></li>
          <li><%= @player.active |> format_player_status %></li>
          <li>
            <a href={@player.repository_url} target="_blank" class="text-indigo-600 hover:text-indigo-500">
              Repository
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-4">
      <%= if @player.active do %>
        <.link
          href={~p"/account/players/#{@player.id}?player[active]=false"}
          method="put"
          class="w-full inline-flex justify-center items-center px-4 py-2 border border-red-600 text-sm font-medium rounded-md text-red-600 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
        >
          Click to deactivate
        </.link>
      <% else %>
        <.link
          href={~p"/account/players/#{@player.id}?player[active]=true"}
          method="put"
          class="w-full inline-flex justify-center items-center px-4 py-2 border border-indigo-600 text-sm font-medium rounded-md text-indigo-600 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
        >
          Click to activate
        </.link>
      <% end %>
    </div>
  </div>
</div>
