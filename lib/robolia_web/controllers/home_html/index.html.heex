<.flash_group flash={@flash} />

<%= unless @current_user do %>
<div class="relative isolate px-6 lg:px-8">
    <div class="mx-auto max-w-2xl py-32 sm:py-28 lg:py-46">
      <div class="text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">The plataform for game bots</h1>
        <p class="mt-6 text-lg leading-8 text-gray-600">Designed for programmers who want to create invincible bots to battle against others</p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a href="/auth/github?scope=public_repo" class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Get started</a>
        </div>
      </div>
    </div>
  </div>
<% end %>